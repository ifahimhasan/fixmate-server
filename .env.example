PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
DB_NAME=fixmate
# Must be the SAME value as JWT_SECRET in the client .env.local
JWT_SECRET=replace-with-a-long-random-string
# Comma separated list of allowed origins (local + production client)
CLIENT_URLS=http://localhost:3000,https://your-client.vercel.app
# The client URL used for Stripe success/cancel redirects
CLIENT_URL=http://localhost:3000
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
IMGBB_API_KEY=your-imgbb-key
